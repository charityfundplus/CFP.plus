+        cls._ctx = TestClient(chatgpt_app.app)
+        cls.client = cls._ctx.__enter__()
+
+    @classmethod
+    def tearDownClass(cls) -> None:
+        cls._ctx.__exit__(None, None, None)
+        cls._env.stop()
+
+    def _token(self, scope: str = "read offline_access", redirect: str = REDIRECT):
+        verifier = secrets.token_urlsafe(48)
+        challenge = base64.urlsafe_b64encode(
+            hashlib.sha256(verifier.encode()).digest()
+        ).rstrip(b"=").decode()
+        auth = self.client.get(
+            "/mcp-gemini/authorize",
+            params={
+                "response_type": "code",
+                "client_id": CLIENT_ID,
+                "redirect_uri": redirect,
+                "scope": scope,
+                "state": "gemini-test",
+                "code_challenge": challenge,
+                "code_challenge_method": "S256",
+                "resource": "https://mcp.cfp.plus/mcp-gemini",
+            },
+            follow_redirects=False,
+        )
+        return auth, verifier
+
+    def _full_flow(self, scope: str = "read offline_access") -> dict:
+        auth, verifier = self._token(scope)
+        self.assertEqual(auth.status_code, 302, auth.text)
+        location = auth.headers["location"]
+        self.assertTrue(location.startswith("https://mcp.cfp.plus/oauth/gemini/consent"))
+        txn = parse_qs(urlsplit(location).query)["txn"][0]
+        bad = self.client.post(
+            "/oauth/gemini/consent",
+            data={"txn": txn, "admin_token": "wrong"},
+            follow_redirects=False,
+        )
+        self.assertEqual(bad.status_code, 403)
+        consent = self.client.post(
+            "/oauth/gemini/consent",
+            data={"txn": txn, "admin_token": ADMIN},
+            follow_redirects=False,
+        )
+        self.assertEqual(consent.status_code, 302)
+        code = parse_qs(urlsplit(consent.headers["location"]).query)["code"][0]
+        token = self.client.post(
+            "/mcp-gemini/token",
+            data={
+                "grant_type": "authorization_code",
+                "code": code,
+                "redirect_uri": REDIRECT,
+                "client_id": CLIENT_ID,
+                "client_secret": CLIENT_SECRET,
+                "code_verifier": verifier,
+                "resource": "https://mcp.cfp.plus/mcp-gemini",
+            },
+        )
+        self.assertEqual(token.status_code, 200, token.text)
+        return token.json()
+
+    def test_discovery_metadata_read_only_and_no_registration(self) -> None:
+        prm = self.client.get("/.well-known/oauth-protected-resource/mcp-gemini")
+        self.assertEqual(prm.status_code, 200)
+        self.assertEqual(prm.json()["resource"], "https://mcp.cfp.plus/mcp-gemini")
+        self.assertEqual(prm.json()["scopes_supported"], ["read", "offline_access"])
+        asm = self.client.get("/.well-known/oauth-authorization-server/mcp-gemini")
+        self.assertEqual(asm.status_code, 200)
+        self.assertEqual(asm.json()["code_challenge_methods_supported"], ["S256"])
+        self.assertNotIn("registration_endpoint", asm.json())
+
+    def test_dynamic_registration_disabled(self) -> None:
+        reg = self.client.post(
+            "/mcp-gemini/register",
+            json={"redirect_uris": [REDIRECT], "client_name": "x"},
+        )
+        self.assertNotEqual(reg.status_code, 201)
+
+    def test_unauthenticated_mcp_returns_401_with_resource_metadata(self) -> None:
+        res = self.client.post("/mcp-gemini", headers=MCP_HEADERS, json=INIT)
+        self.assertEqual(res.status_code, 401)
+        self.assertIn("resource_metadata", res.headers.get("www-authenticate", ""))
+
+    def test_wrong_redirect_uri_is_rejected(self) -> None:
+        auth, _ = self._token(redirect=REDIRECT + "-evil")
+        self.assertNotEqual(auth.status_code // 100, 2)
+        location = auth.headers.get("location", "")
+        self.assertNotIn("oauth/gemini/consent", location)
+
+    def test_pkce_flow_grants_read_only(self) -> None:
+        token = self._full_flow("read offline_access")
+        self.assertEqual(sorted(token["scope"].split()), ["offline_access", "read"])
+        self.assertTrue(token["access_token"].startswith("cfp_access_"))
+
+    def test_requesting_elevated_scope_is_refused_before_consent(self) -> None:
+        auth, _ = self._token(scope="read propose execute_approved")
+        location = auth.headers.get("location", "")
+        self.assertNotIn("oauth/gemini/consent", location)
+        self.assertIn("error=invalid_scope", location)
+
+    def test_gemini_token_works_on_gemini_lane_and_not_on_chatgpt_lane(self) -> None:
+        access = self._full_flow()["access_token"]
+        headers = {**MCP_HEADERS, "authorization": f"Bearer {access}"}
+        ok = self.client.post("/mcp-gemini", headers=headers, json=INIT)
+        self.assertEqual(ok.status_code, 200, ok.text)
+        self.assertIn("protocolVersion", ok.text)
+        cross = self.client.post("/mcp-chatgpt", headers=headers, json=INIT)
+        self.assertEqual(cross.status_code, 401)
