+"""Run the Gemini OAuth lane contract in its own process.
+
+The MCP SDK allows StreamableHTTPSessionManager.run() once per process, and other
+test modules already start the app lifespan. Isolating the Gemini cases keeps both
+suites independent without changing existing tests.
+"""
+
+import subprocess
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class GeminiOAuthLaneIsolated(unittest.TestCase):
+    def test_gemini_lane_contract(self) -> None:
+        result = subprocess.run(
+            [sys.executable, "-m", "unittest", "-v", "tests.gemini_lane_cases"],
+            cwd=ROOT,
+            capture_output=True,
+            text=True,
+            timeout=300,
+        )
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
