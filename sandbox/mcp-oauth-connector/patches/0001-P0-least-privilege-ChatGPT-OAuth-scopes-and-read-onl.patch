diff --git a/gemini_oauth.py b/gemini_oauth.py
new file mode 100644
index 0000000..1fad0ea
--- /dev/null
+++ b/gemini_oauth.py
@@ -0,0 +1,133 @@
+"""OAuth 2.1 lane for Gemini custom MCP connectors (CFP+ AI 691141).
+
+Reuses ChatGPTOAuthProvider with a Gemini-specific configuration:
+
+* issuer/resource https://mcp.cfp.plus/mcp-gemini
+* read scope only (least privilege)
+* dynamic client registration disabled: Gemini is configured with a
+  pre-registered Client ID and Client Secret, seeded at start-up from
+  CFP_GEMINI_OAUTH_CLIENT_ID / CFP_GEMINI_OAUTH_CLIENT_SECRET
+* redirect URIs must match CFP_GEMINI_OAUTH_REDIRECT_URIS exactly
+* consent requires CFP_GEMINI_OAUTH_ADMIN_TOKEN (no fallback to shared secrets)
+* OAuth state is stored under the "gemini:" prefix, so Gemini tokens are never
+  accepted by the ChatGPT lane and vice versa
+"""
+
+from __future__ import annotations
+
+import hmac
+import os
+
+from pydantic import AnyHttpUrl
+
+from mcp.server.auth.settings import AuthSettings, ClientRegistrationOptions
+from mcp.shared.auth import OAuthClientInformationFull
+
+from chatgpt_oauth import ChatGPTOAuthProvider
+
+GEMINI_BASE_URL = "https://mcp.cfp.plus/mcp-gemini"
+GEMINI_RESOURCE_URL = GEMINI_BASE_URL
+GEMINI_CONSENT_URL = "https://mcp.cfp.plus/oauth/gemini/consent"
+GEMINI_PROTECTED_RESOURCE_METADATA_URL = (
+    "https://mcp.cfp.plus/.well-known/oauth-protected-resource/mcp-gemini"
+)
+GEMINI_AI_ID = "691141"
+GEMINI_AI_NAME = "Gemini"
+GEMINI_DEFAULT_SCOPES = ["read"]
+GEMINI_VALID_SCOPES = ["read", "offline_access"]
+DEFAULT_GEMINI_REDIRECT_URIS = (
+    "https://oauth-redirect.googleusercontent.com/r/"
+    "user_bound_custom-mcp-db6be1542137b3a9ae65fd92"
+)
+
+GEMINI_PROTECTED_RESOURCE_METADATA = {
+    "resource": GEMINI_RESOURCE_URL,
+    "authorization_servers": [GEMINI_BASE_URL],
+    "scopes_supported": GEMINI_VALID_SCOPES,
+    "bearer_methods_supported": ["header"],
+}
+
+GEMINI_AUTHORIZATION_SERVER_METADATA = {
+    "issuer": GEMINI_BASE_URL,
+    "authorization_endpoint": f"{GEMINI_BASE_URL}/authorize",
+    "token_endpoint": f"{GEMINI_BASE_URL}/token",
+    "scopes_supported": GEMINI_VALID_SCOPES,
+    "response_types_supported": ["code"],
+    "grant_types_supported": ["authorization_code", "refresh_token"],
+    "token_endpoint_auth_methods_supported": [
+        "client_secret_post",
+        "client_secret_basic",
+    ],
+    "code_challenge_methods_supported": ["S256"],
+}
+
+
+def gemini_token_auth_method() -> str:
+    # The MCP SDK enforces exactly one method per client. Gemini's method is not
+    # yet verified; set CFP_GEMINI_OAUTH_TOKEN_AUTH_METHOD=client_secret_basic if
+    # the live token exchange shows Gemini sends HTTP Basic credentials.
+    method = (os.getenv("CFP_GEMINI_OAUTH_TOKEN_AUTH_METHOD") or "client_secret_post").strip()
+    return method if method in {"client_secret_post", "client_secret_basic"} else "client_secret_post"
+
+
+def gemini_redirect_uris() -> list[str]:
+    raw = os.getenv("CFP_GEMINI_OAUTH_REDIRECT_URIS") or DEFAULT_GEMINI_REDIRECT_URIS
+    return [uri.strip() for uri in raw.split(",") if uri.strip()]
+
+
+class GeminiOAuthProvider(ChatGPTOAuthProvider):
+    state_prefix = "gemini:"
+    subject_ai_id = GEMINI_AI_ID
+    consent_url = GEMINI_CONSENT_URL
+    resource_url = GEMINI_RESOURCE_URL
+    default_scopes = GEMINI_DEFAULT_SCOPES
+    valid_scopes = GEMINI_VALID_SCOPES
+
+    @staticmethod
+    def _redirect_allowed(uri: str) -> bool:
+        # Exact string match only; no host or prefix matching.
+        return uri in gemini_redirect_uris()
+
+    def admin_secret(self) -> str:
+        return (os.getenv("CFP_GEMINI_OAUTH_ADMIN_TOKEN") or "").strip()
+
+    def admin_secret_matches(self, supplied: str) -> bool:
+        expected = self.admin_secret()
+        if not expected:
+            return False
+        return hmac.compare_digest(supplied.strip().encode("utf-8"), expected.encode("utf-8"))
+
+    async def register_client(self, client_info: OAuthClientInformationFull) -> None:
+        raise ValueError("Dynamic client registration is disabled for the Gemini lane")
+
+    def seed_client_from_env(self) -> bool:
+        """Store the pre-registered Gemini client. Returns False when not configured."""
+        client_id = (os.getenv("CFP_GEMINI_OAUTH_CLIENT_ID") or "").strip()
+        client_secret = (os.getenv("CFP_GEMINI_OAUTH_CLIENT_SECRET") or "").strip()
+        if not client_id or not client_secret:
+            return False
+        client = OAuthClientInformationFull(
+            client_id=client_id,
+            client_secret=client_secret,
+            client_name="CFP+ Gemini custom MCP connector",
+            redirect_uris=[AnyHttpUrl(uri) for uri in gemini_redirect_uris()],
+            grant_types=["authorization_code", "refresh_token"],
+            response_types=["code"],
+            token_endpoint_auth_method=gemini_token_auth_method(),
+            scope=" ".join(GEMINI_VALID_SCOPES),
+        )
+        self._put_state("client", client_id, self._model_data(client))
+        return True
+
+
+def gemini_auth_settings() -> AuthSettings:
+    return AuthSettings(
+        issuer_url=AnyHttpUrl(GEMINI_BASE_URL),
+        resource_server_url=AnyHttpUrl(GEMINI_RESOURCE_URL),
+        required_scopes=["read"],
+        client_registration_options=ClientRegistrationOptions(
+            enabled=False,
+            valid_scopes=GEMINI_VALID_SCOPES,
+            default_scopes=GEMINI_VALID_SCOPES,
+        ),
+    )
