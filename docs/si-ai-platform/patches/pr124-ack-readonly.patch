new file mode 100644
index 0000000..aa7a474
--- /dev/null
+++ b/drafts/si-office/core/readonly-source-adapter.mjs
@@ -0,0 +1,88 @@
+// READ ONLY source adapter • PROPOSAL (PR #232 → PR #124) • NOT ACTIVATED.
+// Same untrusted-adapter contract as MockSIAdapter: it only *proposes* {tools, output}; the Core still
+// checks tools, permissions, cross-checks and requires independent review.
+// Hard limits:
+//  - Disabled unless a Human Governance approval record is supplied (decisionRef, approver, scope, expiry).
+//  - Reads only allow-listed files under one root directory; no '..', no absolute paths, no symlinks,
+//    size-capped, UTF-8 text only. No network: externalRequests is always 0 and no fetch/http is imported.
+//  - Never writes. Output stays a DRAFT with every identity/verification claim false/null (Core contract).
+// No caller in PR #124 wires this adapter by default; P2Sandbox keeps the mock unless an operator passes
+// `adapterFactory: createReadOnlyAdapterFactory({...})` after approval.
+import { readFileSync, lstatSync, realpathSync } from 'node:fs';
+import { resolve, sep, isAbsolute } from 'node:path';
+import { hash } from './common.mjs';
+
+const MAX_BYTES = 256 * 1024;
+const DECISION = /^HG-[0-9]{1,4}(-[A-Z0-9]{1,12})?$/;
+
+export function validateApproval(approval, now = Date.now()) {
+  if (!approval || typeof approval !== 'object' || Array.isArray(approval)) throw Error('READ_ONLY_ADAPTER_NOT_APPROVED');
+  const keys = ['decisionRef', 'approvedBy', 'scope', 'expiresAt', 'resources'];
+  if (Object.keys(approval).some((k) => !keys.includes(k)) || keys.some((k) => !(k in approval))) throw Error('READ_ONLY_APPROVAL_INVALID');
+  if (!DECISION.test(approval.decisionRef) || typeof approval.approvedBy !== 'string' || !approval.approvedBy.trim() || approval.approvedBy.length > 100) throw Error('READ_ONLY_APPROVAL_INVALID');
+  if (approval.scope !== 'read-only') throw Error('READ_ONLY_SCOPE_REQUIRED');
+  const exp = Date.parse(approval.expiresAt);
+  if (!Number.isFinite(exp) || exp <= now) throw Error('READ_ONLY_APPROVAL_EXPIRED');
+  if (!Array.isArray(approval.resources) || !approval.resources.length || approval.resources.length > 20) throw Error('READ_ONLY_APPROVAL_INVALID');
+  return true;
+}
+
+function safePath(root, rel) {
+  if (typeof rel !== 'string' || !rel || rel.length > 300 || isAbsolute(rel) || rel.includes('\0') || rel.split(/[\\/]/).includes('..')) throw Error('READ_ONLY_PATH_DENIED');
+  const base = realpathSync(root);
+  const full = resolve(base, rel);
+  if (!full.startsWith(base + sep)) throw Error('READ_ONLY_PATH_DENIED');
+  const st = lstatSync(full);
+  if (st.isSymbolicLink() || !st.isFile()) throw Error('READ_ONLY_PATH_DENIED');
+  if (realpathSync(full) !== full) throw Error('READ_ONLY_PATH_DENIED');
+  if (st.size > MAX_BYTES) throw Error('READ_ONLY_FILE_TOO_LARGE');
+  return full;
+}
+
+export class ReadOnlySourceAdapter {
+  #root; #sources; #provider; #approval; #clock;
+  /**
+   * @param {{provider:string, root:string, sources:Record<string,string>, approval:object, clock?:()=>number}} opts
+   * sources maps a Core resource key (e.g. 'website-demo') to a file path relative to root.
+   */
+  constructor({ provider, root, sources, approval, clock = () => Date.now() } = {}) {
+    validateApproval(approval, clock());
+    if (typeof provider !== 'string' || !provider) throw Error('READ_ONLY_PROVIDER_REQUIRED');
+    if (!sources || typeof sources !== 'object' || !Object.keys(sources).length) throw Error('READ_ONLY_SOURCES_REQUIRED');
+    for (const r of Object.keys(sources)) if (!approval.resources.includes(r)) throw Error('READ_ONLY_RESOURCE_NOT_APPROVED');
+    this.#root = root; this.#sources = { ...sources }; this.#provider = provider; this.#approval = structuredClone(approval); this.#clock = clock;
+  }
+  async propose({ task, source, signal }) {
+    validateApproval(this.#approval, this.#clock()); // expiry is re-checked on every call
+    if (signal?.aborted) throw Error('ADAPTER_ABORTED');
+    const rel = this.#sources[task.resource];
+    if (!rel) throw Error('READ_ONLY_RESOURCE_NOT_APPROVED');
+    const bytes = readFileSync(safePath(this.#root, rel));
+    const text = bytes.toString('utf8');
+    if (Buffer.from(text, 'utf8').length !== bytes.length) throw Error('READ_ONLY_NOT_UTF8');
+    const lines = text.split('\n').length;
+    const fileSha = hash(text);
+    const summary = [
+      `${task.title}`,
+      `READ ONLY • ${this.#approval.decisionRef} • ${rel}`,
+      `sha256:${fileSha} • bytes:${bytes.length} • lines:${lines}`,
+      `Excerpt: ${text.slice(0, 600).replace(/\s+/g, ' ').trim()}`,
+    ].join('\n').slice(0, 3000);
+    return {
+      adapter: this.#provider, protocol: 1, externalRequests: 0,
+      tools: [{ tool: 'source.read', resource: task.resource }],
+      output: {
+        title: task.title.slice(0, 200), text: summary,
+        source: { resource: source.resource, sha256: source.sha256 },
+        synthetic: true, id: null, parent: null, did: null, canonical: null,
+        sourceVerified: false, capabilityVerified: false, legalRelationshipVerified: false, mode: 'DRAFT ONLY',
+      },
+    };
+  }
+}
+
+/** Factory for P2Sandbox/CoreEngine `adapterFactory`. Throws (fail closed) without a valid approval. */
+export function createReadOnlyAdapterFactory({ root, sources, approval, clock } = {}) {
+  validateApproval(approval, (clock ?? Date.now)());
+  return (provider) => new ReadOnlySourceAdapter({ provider, root, sources, approval, clock });
+}
