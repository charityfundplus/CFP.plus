+import { P2Sandbox } from '../sandbox/p2-service.mjs';
+import { CoreEngine } from '../core/core-engine.mjs';
+import { ReadOnlySourceAdapter, createReadOnlyAdapterFactory, validateApproval } from '../core/readonly-source-adapter.mjs';
+
+const PW = 'Synthetic-test-password!';
+const input = { kind: 'registry-audit', title: 'ACK test', text: 'sandbox', scenario: 'normal', resource: 'website-demo' };
+const future = new Date(Date.now() + 3600e3).toISOString();
+const approval = (over = {}) => ({ decisionRef: 'HG-17', approvedBy: 'Human Governance (test fixture)', scope: 'read-only', expiresAt: future, resources: ['website-demo'], ...over });
+function setup(opts = {}) {
+  const dir = mkdtempSync(join(tmpdir(), 'cfp-ack-')), s = new P2Sandbox(join(dir, 'state.db'), opts);
+  for (const [id, role] of [['editor', 'editor'], ['editor2', 'editor'], ['reviewer', 'reviewer'], ['viewer', 'viewer']]) s.provision({ id, password: PW, role, workspace: 'alpha', maintainer: false });
+  return { s, dir, tok: (id) => s.login(id, PW), clean: () => { s.close(); rmSync(dir, { recursive: true, force: true }); } };
+}
+const create = (x, t, key) => x.s.execute(t, 'createTask', { pairKey: 'hub69-content-demo', input }, { idempotencyKey: key });
+
+test('ACK-1 owner ACK moves QUEUED → ACKNOWLEDGED with a task digest; audited', async () => {
+  const x = setup(); try {
+    const e = x.tok('editor'); const t = await create(x, e, 'a1');
+    const acked = await x.s.execute(e, 'ackTask', { taskKey: t.key });
+    assert.equal(acked.status, 'ACKNOWLEDGED');
+    assert.equal(acked.ack.actor, 'editor');
+    assert.match(acked.ack.taskDigest, /^[0-9a-f]{64}$/);
+    const before = x.s.verify().sequence;
+    const run = await x.s.execute(e, 'runTask', { taskKey: t.key });
+    assert.equal(run.status, 'AWAITING HUMAN REVIEW');
+    assert.ok(x.s.verify().sequence > before);
+  } finally { x.clean(); }
+});
+
+test('ACK-2 only the owner may ACK, only once, never by viewer', async () => {
+  const x = setup(); try {
+    const t = await create(x, x.tok('editor'), 'a2');
+    await assert.rejects(x.s.execute(x.tok('editor2'), 'ackTask', { taskKey: t.key }), /ACK_OWNER_REQUIRED/);
+    await assert.rejects(x.s.execute(x.tok('reviewer'), 'ackTask', { taskKey: t.key }), /ACK_OWNER_REQUIRED/);
+    await assert.rejects(x.s.execute(x.tok('viewer'), 'ackTask', { taskKey: t.key }), /PERMISSION_DENIED/);
+    await x.s.execute(x.tok('editor'), 'ackTask', { taskKey: t.key });
+    await assert.rejects(x.s.execute(x.tok('editor'), 'ackTask', { taskKey: t.key }), /ACK_STATE_INVALID/);
+  } finally { x.clean(); }
+});
+
+test('ACK-3 strict mode (requireAck) refuses run without ACK; legacy mode unchanged', async () => {
+  const strict = setup({ requireAck: true }); try {
+    const e = strict.tok('editor'); const t = await create(strict, e, 'a3');
+    await assert.rejects(strict.s.execute(e, 'runTask', { taskKey: t.key }), /TASK_OR_PAIR_NOT_READY/);
+    await strict.s.execute(e, 'ackTask', { taskKey: t.key });
+    assert.equal((await strict.s.execute(e, 'runTask', { taskKey: t.key })).status, 'AWAITING HUMAN REVIEW');
+  } finally { strict.clean(); }
+  const legacy = setup(); try {
+    const e = legacy.tok('editor'); const t = await create(legacy, e, 'a4');
+    assert.equal((await legacy.s.execute(e, 'runTask', { taskKey: t.key })).status, 'AWAITING HUMAN REVIEW');
+  } finally { legacy.clean(); }
+});
+
+test('ACK-4 ACKNOWLEDGED task is interrupted on safe stop', async () => {
+  const x = setup(); try {
+    const e = x.tok('editor'), r = x.tok('reviewer'); const t = await create(x, e, 'a5');
+    await x.s.execute(e, 'ackTask', { taskKey: t.key });
+    await x.s.execute(r, 'stop', { pairKey: 'hub69-content-demo' });
+    const snap = await x.s.execute(r, 'snapshot');
+    assert.equal(snap.tasks.find((k) => k.key === t.key).status, 'INTERRUPTED');
+  } finally { x.clean(); }
+});
+
+test('RO-1 adapter refuses to exist without a valid Human Governance approval (fail closed)', () => {
+  assert.throws(() => new ReadOnlySourceAdapter({ provider: 'mock-local', root: '.', sources: { 'website-demo': 'x' } }), /NOT_APPROVED/);
+  assert.throws(() => validateApproval(approval({ decisionRef: 'yes' })), /APPROVAL_INVALID/);
+  assert.throws(() => validateApproval(approval({ scope: 'read-write' })), /SCOPE_REQUIRED/);
+  assert.throws(() => validateApproval(approval({ expiresAt: '2000-01-01T00:00:00Z' })), /EXPIRED/);
+  assert.throws(() => validateApproval({ ...approval(), extra: 1 }), /APPROVAL_INVALID/);
+  assert.throws(() => createReadOnlyAdapterFactory({ root: '.', sources: { 'website-demo': 'x' }, approval: approval({ resources: ['other'] }) })('mock-local'), /RESOURCE_NOT_APPROVED/);
+});
+
+test('RO-2 path traversal, absolute paths, symlinks and large files are denied', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'cfp-ro-')); try {
+    mkdirSync(join(dir, 'root')); writeFileSync(join(dir, 'secret.txt'), 'outside');
+    writeFileSync(join(dir, 'root', 'big.txt'), 'x'.repeat(300 * 1024));
+    symlinkSync(join(dir, 'secret.txt'), join(dir, 'root', 'link.txt'));
+    const task = { title: 't', resource: 'website-demo' }, source = { resource: 'website-demo', sha256: 'a' };
+    for (const rel of ['../secret.txt', join(dir, 'secret.txt'), 'link.txt', 'big.txt', 'missing.txt']) {
+      const a = new ReadOnlySourceAdapter({ provider: 'mock-local', root: join(dir, 'root'), sources: { 'website-demo': rel }, approval: approval() });
+      await assert.rejects(a.propose({ task, source }), /READ_ONLY_PATH_DENIED|READ_ONLY_FILE_TOO_LARGE|ENOENT/);
+    }
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('RO-3 approval expiry is re-checked at every call', async () => {
+  let now = Date.now(); const dir = mkdtempSync(join(tmpdir(), 'cfp-ro-')); try {
+    writeFileSync(join(dir, 'a.md'), '# ok');
+    const a = new ReadOnlySourceAdapter({ provider: 'mock-local', root: dir, sources: { 'website-demo': 'a.md' }, approval: approval(), clock: () => now });
+    await a.propose({ task: { title: 't', resource: 'website-demo' }, source: { resource: 'website-demo', sha256: 'a' } });
+    now += 7200e3;
+    await assert.rejects(a.propose({ task: { title: 't', resource: 'website-demo' }, source: { resource: 'website-demo', sha256: 'a' } }), /EXPIRED/);
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('RO-4 with test approval the adapter passes all Core checks, reads a real file, makes 0 external requests', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'cfp-ro-')); try {
+    writeFileSync(join(dir, 'README.md'), '# CFP+\nHUB 69 • 5 Nhóm • 10 Chương\n');
+    const factory = createReadOnlyAdapterFactory({ root: dir, sources: { 'website-demo': 'README.md' }, approval: approval() });
+    const reviewer = { id: 'r', role: 'reviewer' }, editor = { id: 'e', role: 'editor' };
+    const engine = new CoreEngine({ adapterFactory: factory, requireAck: true });
+    const t = engine.createTask(editor, 'hub69-content-demo', input);
+    engine.ackTask(editor, t.key);
+    const out = await engine.runTask(editor, t.key);
+    assert.equal(out.status, 'AWAITING HUMAN REVIEW');
+    assert.match(out.output.text, /READ ONLY • HG-17 • README\.md/);
+    assert.match(out.output.text, /sha256:[0-9a-f]{64}/);
+    assert.equal(out.output.mode, 'DRAFT ONLY');
+    assert.equal(engine.reviewTask(reviewer, t.key, 'acknowledge-draft').status, 'REVIEWED DRAFT');
+    const src = readFileSync(new URL('../core/readonly-source-adapter.mjs', import.meta.url), 'utf8');
+    assert.ok(!/\bfrom\s+['"]node:(http|https|net|tls|dgram)['"]|\bfetch\(/.test(src), 'adapter must not import network modules');
+    assert.ok(!/writeFile|appendFile|unlink|rmSync|mkdir/.test(src), 'adapter must not write');
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('RO-5 default wiring stays mock: P2Sandbox without adapterFactory never uses the read-only adapter', async () => {
+  const x = setup(); try {
+    const e = x.tok('editor'); const t = await create(x, e, 'ro5');
+    const run = await x.s.execute(e, 'runTask', { taskKey: t.key });
+    assert.equal(run.output.synthetic, true);
+    assert.ok(!/READ ONLY • HG-/.test(run.output.text));
+  } finally { x.clean(); }
+});
