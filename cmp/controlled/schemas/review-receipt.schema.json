{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cfp.plus/schemas/cmp/review-receipt.v1.json",
  "title": "CMP Review Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_receipt_id", "work_order_ref", "correlation_id", "reviewer", "review_scope", "evidence_set", "review_result", "submitted_at", "independence_attestation", "source_artifact"],
  "properties": {
    "review_receipt_id": {"type": "string", "pattern": "^rrc_[0-9A-HJKMNP-TV-Z]{26}$"},
    "work_order_ref": {"type": "string"},
    "correlation_id": {"type": "string", "pattern": "^cor_[0-9A-HJKMNP-TV-Z]{26}$"},
    "reviewer": {"type": "object", "additionalProperties": false, "required": ["principal_id", "reviewer_type", "provider_or_organization_ref"], "properties": {"principal_id": {"type": "string"}, "reviewer_type": {"enum": ["human", "ai", "service_assisted_human"]}, "provider_or_organization_ref": {"type": "string"}, "agent_or_model_ref": {"type": ["string", "null"]}}},
    "review_scope": {"type": "object", "additionalProperties": false, "required": ["artifact_version_ref", "policy_version", "review_standard_version"], "properties": {"artifact_version_ref": {"type": "string"}, "policy_version": {"type": "string"}, "review_standard_version": {"type": "string"}, "work_definition_snapshot_id": {"type": ["string", "null"]}}},
    "evidence_set": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["evidence_manifest_id", "content_hash", "verification_status"], "properties": {"evidence_manifest_id": {"type": "string", "pattern": "^evm_[0-9A-HJKMNP-TV-Z]{26}$"}, "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "verification_status": {"const": "VERIFIED"}}}},
    "review_result": {"type": "object", "additionalProperties": false, "required": ["verdict", "findings"], "properties": {"verdict": {"enum": ["PASS", "PASS_WITH_CHANGES", "FAIL", "INCONCLUSIVE", "CONFLICT"]}, "findings": {"type": "array", "items": {"type": "object", "required": ["finding_id", "finding", "evidence_refs", "risk", "recommendation", "closure_criteria"], "properties": {"finding_id": {"type": "string"}, "finding": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "risk": {"type": "string"}, "recommendation": {"type": "string"}, "closure_criteria": {"type": "string"}}}}}},
    "independence_attestation": {"type": "object", "additionalProperties": false, "required": ["executor_overlap", "conflict_of_interest_declared", "policy_check_status"], "properties": {"executor_overlap": {"type": "boolean"}, "conflict_of_interest_declared": {"type": "boolean"}, "conflict_statement": {"type": ["string", "null"]}, "policy_check_status": {"enum": ["PASS", "FAIL", "PENDING_HUMAN_REVIEW"]}}},
    "source_artifact": {"type": "object", "additionalProperties": false, "required": ["source_system", "source_reference", "captured_manifest_id"], "properties": {"source_system": {"enum": ["GITHUB", "NOTION", "CMP_CORE", "OTHER_APPROVED"]}, "source_reference": {"type": "string"}, "captured_manifest_id": {"type": "string", "pattern": "^evm_[0-9A-HJKMNP-TV-Z]{26}$"}}},
    "submitted_at": {"type": "string", "format": "date-time"}
  }
}
