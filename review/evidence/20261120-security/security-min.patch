From 129472442d1725e67f6af1023dae6a5e4298cdc5 Mon Sep 17 00:00:00 2001
From: Claude Code <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 17:46:42 +0000
Subject: [PATCH] security: stop serving .git and internal files from the
 website image

---
 .dockerignore | 12 ++++++++++++
 Dockerfile    | 11 +++++++++++
 2 files changed, 23 insertions(+)
 create mode 100644 .dockerignore

diff --git a/.dockerignore b/.dockerignore
new file mode 100644
index 0000000..d9a0572
--- /dev/null
+++ b/.dockerignore
@@ -0,0 +1,12 @@
+# Keep repository internals out of the public web root.
+# Before this file existed, https://cfp.plus/.git/config was publicly readable.
+.git
+.github
+.gitignore
+.dockerignore
+Dockerfile
+**/__pycache__
+**/*.pyc
+tests
+run_ctttc_v066_tests.py
+patches
diff --git a/Dockerfile b/Dockerfile
index cd4e2f1..48579cb 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -7,11 +7,22 @@ RUN printf 'server {\n\
     server_name _;\n\
     absolute_redirect off;\n\
     port_in_redirect off;\n\
+    server_tokens off;\n\
     root /usr/share/nginx/html;\n\
     index index.html;\n\
+    charset utf-8;\n\
+    add_header X-Content-Type-Options "nosniff" always;\n\
+    add_header Referrer-Policy "strict-origin-when-cross-origin" always;\n\
+    location ~ /\\. {\n\
+        return 404;\n\
+    }\n\
     location ~ ^/[0-9]+(?:/[0-9]+)*/?$ {\n\
         try_files $uri/index.html $uri /id/index.html;\n\
     }\n\
+    location ~* \\.md$ {\n\
+        types { }\n\
+        default_type text/plain;\n\
+    }\n\
     location / {\n\
         try_files $uri/index.html $uri =404;\n\
     }\n\
-- 
2.43.0

